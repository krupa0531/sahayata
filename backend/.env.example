# Keep this file without real credentials. Set these values in your terminal or deployment environment.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Adam, a pre-made male voice. Replace it with a male voice ID from your ElevenLabs account if desired.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Twilio Verify (production mobile-number OTP). Never put these values in frontend code.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RAG administration is disabled unless this token is set. Keep it server-side.
SAHAYATA_RAG_ADMIN_TOKEN=replace_with_a_long_random_value
# Optional: enables high-quality summaries using only retrieved, approved sources.
OPENAI_API_KEY=your_openai_api_key
SAHAYATA_RAG_OPENAI_MODEL=gpt-4o-mini
